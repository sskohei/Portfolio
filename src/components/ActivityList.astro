---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../data/content';

interface Props {
  entries: CollectionEntry<'activities'>[];
  heading?: 'h2' | 'h3';
}

const { entries, heading: Heading = 'h3' } = Astro.props;
---
{entries.length > 0 ? (
  <ul class="activity-list">
    {entries.map(({ data }) => (
      <li class="activity-row">
        <time datetime={data.date}>{formatDate(data.date)}</time>
        <div class="activity-copy">
          <Heading>{data.title}</Heading>
          <p>{data.summary}</p>
          {data.links.length > 0 && (
            <ul class="activity-links">
              {data.links.map(({ label, url }) => (
                <li><a class="text-link" href={url}>{label}</a></li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ul>
) : <p class="empty-state">公開中の活動はまだありません。</p>}
