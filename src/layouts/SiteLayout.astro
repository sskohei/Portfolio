---
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.description } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [
  { url: '/projects/', label: '作品' },
  { url: '/activities/', label: '活動' },
  { url: '/#about', label: 'プロフィール' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title ? `${title} | ${profile.name}` : profile.name}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">本文に移動</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">{profile.name}</span>
        </a>
        <nav class="site-nav" aria-label="メインナビゲーション">
          {nav.map(({ url, label }) => (
            <a href={url} aria-current={
              currentPath === url ? 'page' : currentPath.startsWith(url) ? 'location' : undefined
            }>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <small>© {new Date().getUTCFullYear()} {profile.name}</small>
        <a class="text-link" href="/">ホーム</a>
      </div>
    </footer>
  </body>
</html>
