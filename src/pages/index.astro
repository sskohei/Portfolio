---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ActivityList from '../components/ActivityList.astro';
import { getPublishedEntries } from '../data/content';
import { profile } from '../data/profile';

const [projects, activities] = await Promise.all([
  getPublishedEntries('projects'),
  getPublishedEntries('activities'),
]);
const featured = projects.filter(({ data }) => data.featured).slice(0, 3);
const highlights = featured.length > 0 ? featured : projects.slice(0, 3);
---
<SiteLayout>
  <section class="shell hero" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow">個人制作ポートフォリオ</p>
      <h1 id="intro-title">{profile.headline[0]}<br /><span>{profile.headline[1]}</span></h1>
      <p class="hero-intro">{profile.description}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">作品を見る</a>
        <a class="button button-secondary" href="/activities/">活動を見る</a>
      </div>
    </div>
    <figure class="hero-visual">
      <img src="/images/workspace.webp" alt="" width="1200" height="800" fetchpriority="high" />
    </figure>
  </section>

  <section class="shell section" aria-labelledby="projects-title">
    <div class="section-heading">
      <div class="section-title">
        <h2 id="projects-title">{featured.length > 0 ? '代表作' : '作品'}</h2>
      </div>
      <a class="text-link" href="/projects/">作品一覧</a>
    </div>
    {highlights.length > 0 ? (
      <div class="project-grid">
        {highlights.map((project) => <ProjectCard project={project} />)}
      </div>
    ) : <p class="empty-state">公開中の作品はまだありません。</p>}
  </section>

  <section class="shell section" aria-labelledby="activities-title">
    <div class="section-heading">
      <div class="section-title">
        <h2 id="activities-title">最近の活動</h2>
      </div>
      <a class="text-link" href="/activities/">活動一覧</a>
    </div>
    <ActivityList entries={activities.slice(0, 3)} />
  </section>

  <section id="about" class="shell section about" aria-labelledby="about-title">
    <div class="about-copy">
      <h2 id="about-title">プロフィール</h2>
      <p>{profile.bio}</p>
      {profile.links.length > 0 && (
        <ul class="contact-links">
          {profile.links.map(({ label, url }) => (
            <li><a class="text-link" href={url}>{label}</a></li>
          ))}
        </ul>
      )}
    </div>
  </section>
</SiteLayout>
